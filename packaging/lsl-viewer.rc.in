// Windows resource script (configured by CMake from lsl-viewer.rc.in): gives lsl_viewer.exe
// its application icon and a VERSIONINFO block (File/Product version in Explorer > Details,
// "Apps & features", and installers). ID 1 = the default application icon. The .ico is
// generated from packaging/lsl-viewer.png by packaging/make_ico.py. The version fields are
// single-sourced from project(... VERSION ...) in CMakeLists.txt.
#include <winver.h>

1 ICON "@LSL_VIEWER_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "LSL Stream Viewer"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "ProductName",      "LSL Stream Viewer"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
            VALUE "OriginalFilename", "lsl_viewer.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
